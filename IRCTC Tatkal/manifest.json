{
  "manifest_version": 3,
  "name": "IRCTC Tatkal Booking",
  "version": "1.0",
  "description": "Chrome Extension to search and book IRCTC train tickets quickly and efficiently.",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.irctc.co.in/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon32.png",
      "48": "icons/icon32.png",
      "128": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon32.png",
    "48": "icons/icon32.png",
    "128": "icons/icon32.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.irctc.co.in/*"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
